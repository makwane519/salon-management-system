<div class="page-heading">
  <div>
    <h1>Our Customers</h1>
    <p>Manage customer profiles and contact information.</p>
  </div>

  <%= link_to "+ Add Customer", new_customer_path, class: "btn" %>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Total Customers</div>
    <div class="stat-value"><%= @customers.count %></div>
    <div class="stat-description">Registered customers</div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Customer Records</div>
    <div class="stat-value"><%= @customers.size %></div>
    <div class="stat-description">Records on this page</div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Customer Management</div>
    <div class="stat-value">CRM</div>
    <div class="stat-description">Customer relationship management</div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <div>
      <h2>Customer Directory</h2>
      <p>All registered salon customers</p>
    </div>
  </div>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Phone</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if @customers.any? %>
          <% @customers.each do |customer| %>
            <tr>
              <td>
                <span class="service-name">
                  <%= customer.name %>
                </span>
              </td>

              <td><%= customer.phone %></td>

              <td>
                <%= customer.email.presence || "—" %>
              </td>

              <td>
                <div class="actions">
                  <%= link_to "View", customer_path(customer) %>
                  <%= link_to "Edit", edit_customer_path(customer) %>

                  <%= link_to "Delete",
                      customer_path(customer),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete this customer?"
                      },
                      class: "delete-link" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4">
              <div class="empty-state">
                <h3>No customers registered yet</h3>
                <p>Add your first customer to get started.</p>

                <%= link_to "Add Customer",
                    new_customer_path,
                    class: "btn" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>