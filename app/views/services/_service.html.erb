<div id="<%= dom_id service %>">
  <p>
    <strong>Name:</strong>
    <%= service.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= service.description %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= service.price %>
  </p>

  <p>
    <strong>Duration minutes:</strong>
    <%= service.duration_minutes %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= service.active %>
  </p>

</div>
