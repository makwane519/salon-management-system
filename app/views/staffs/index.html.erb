<div class="page-heading">
  <div>
    <h1>Our Team</h1>
    <p>Manage your salon employees and their information.</p>
  </div>

  <%= link_to "+ Add Staff", new_staff_path, class: "btn" %>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Total Staff</div>
    <div class="stat-value"><%= @staffs.count %></div>
    <div class="stat-description">Registered employees</div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Active Staff</div>
    <div class="stat-value"><%= @staffs.count { |member| member.active? } %></div>
    <div class="stat-description">Currently active employees</div>
  </div>

  <div class="stat-card">
    <div class="stat-label">Staff Roles</div>
    <div class="stat-value"><%= @staffs.map(&:role).compact.uniq.count %></div>
    <div class="stat-description">Different roles represented</div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <div>
      <h2>Staff Directory</h2>
      <p>All registered salon employees</p>
    </div>
  </div>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>Phone</th>
          <th>Salary</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if @staffs.any? %>
          <% @staffs.each do |member| %>
            <tr>
              <td>
                <span class="service-name">
                  <%= member.name %>
                </span>
              </td>

              <td><%= member.role %></td>
              <td><%= member.phone %></td>

              <td>
                <%= member.salary.present? ? number_to_currency(member.salary) : "—" %>
              </td>

              <td>
                <%= member.active? ? "Active" : "Inactive" %>
              </td>

              <td>
                <div class="actions">
                  <%= link_to "View", staff_path(member) %>
                  <%= link_to "Edit", edit_staff_path(member) %>

                  <%= link_to "Delete",
                      staff_path(member),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete this staff member?"
                      },
                      class: "delete-link" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6">
              <div class="empty-state">
                <h3>No staff members yet</h3>
                <p>Add your first employee to get started.</p>
                <%= link_to "Add Staff", new_staff_path, class: "btn" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>