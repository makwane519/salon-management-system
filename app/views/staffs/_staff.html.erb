<div id="<%= dom_id staff %>">
  <p>
    <strong>Name:</strong>
    <%= staff.name %>
  </p>

  <p>
    <strong>Role:</strong>
    <%= staff.role %>
  </p>

  <p>
    <strong>Phone:</strong>
    <%= staff.phone %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= staff.email %>
  </p>

  <p>
    <strong>Salary:</strong>
    <%= staff.salary %>
  </p>

  <p>
    <strong>Joining date:</strong>
    <%= staff.joining_date %>
  </p>

  <p>
    <strong>Active:</strong>
    <%= staff.active %>
  </p>

</div>
